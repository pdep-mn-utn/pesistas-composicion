import pesistasComposicion.*

describe "Pesista que hace crossfit" {

  const pesista = new Pesista(imm = 50, disciplina = crossfit)

  test "entrenar fierros 24 horas suma 1 de imm" {
    pesista.entrenaFierros(24)
    assert.equals(51, pesista.imm())
  }

  test "entrenar cardio 10 km resta 1 de imm" {
    pesista.entrenaCardio(10)
    assert.equals(49, pesista.imm())
  }

  test "el cardio nunca deja el imm en negativo" {
    pesista.imm(0.5)
    pesista.entrenaCardio(10)
    assert.equals(0, pesista.imm())
  }

}

describe "Pesista que hace powerlifting" {

  const pesista = new Pesista(imm = 50, disciplina = powerlifting)

  test "entrenar fierros multiplica las horas por los turnos diarios" {
    pesista.entrenaFierros(24)
    assert.equals(53, pesista.imm())
  }

  test "entrenar cardio no modifica su imm" {
    pesista.entrenaCardio(10)
    assert.equals(50, pesista.imm())
  }

  test "si el gimnasio cambia los turnos, cambian para todos los que hacen powerlifting" {
    const otroPesista = new Pesista(imm = 50, disciplina = powerlifting)
    powerlifting.turnosDiarios(2)
    pesista.entrenaFierros(24)
    otroPesista.entrenaFierros(24)
    assert.equals(52, pesista.imm())
    assert.equals(52, otroPesista.imm())
  }

}

describe "Pesista que hace fisicoculturismo" {

  const pesista = new Pesista(imm = 50, disciplina = new Fisicoculturismo())

  test "entrenar fierros entra en calor con 1 km de cardio y suma las horas al cuadrado" {
    pesista.entrenaFierros(12)
    assert.equals(55.9, pesista.imm())   // 50 - 0.1 + 144 / 24
  }

  test "entrenar cardio resta como en crossfit" {
    pesista.entrenaCardio(10)
    assert.equals(49, pesista.imm())
  }

  test "cada fisicoculturista puede tener su propia dosis" {
    const conDosisAlta = new Pesista(imm = 50, disciplina = new Fisicoculturismo(dosisTestosterona = 3))
    conDosisAlta.entrenaFierros(6)
    assert.equals(58.9, conDosisAlta.imm())   // 50 - 0.1 + 216 / 24
  }

}

describe "Cambio de disciplina" {

  const matias = new Pesista(imm = 50, disciplina = crossfit)

  test "al cambiar de disciplina conserva el imm acumulado y entrena con la nueva" {
    matias.entrenaFierros(24)
    matias.disciplina(powerlifting)
    matias.entrenaFierros(24)
    assert.equals(54, matias.imm())   // 50 + 1 (crossfit) + 3 (powerlifting)
  }

}
